    "rateWindowLabels": {"primary": "Session", "secondary": "Weekly"},
    "pace": {"secondary": {"summary": "12% in reserve | Expected 50% used | Lasts until reset"}},
    "usage": {
        "loginMethod": "Claude Max",
        "primary": {"usedPercent": 31, "resetsAt": iso(datetime.timedelta(hours=2, minutes=40)), "windowMinutes": 300},
        "secondary": {"usedPercent": 38, "resetsAt": iso(datetime.timedelta(days=3, hours=6)), "windowMinutes": 10080},
        "tertiary": None, "extraRateWindows": [],
    },
}]))
